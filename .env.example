# ==============================================================================
# Zakat Management System (ZMS) — Enterprise Production Environment Template
# ==============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=zms
POSTGRES_PASSWORD=replace_with_strong_database_password_in_production
POSTGRES_DB=zms
POSTGRES_PORT=5432
DATABASE_URL=postgresql://zms:replace_with_strong_database_password_in_production@postgres:5432/zms?schema=public

# NestJS API Backend Configuration
NODE_ENV=production
API_PORT=4000
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace_with_a_long_random_cryptographic_secret_key_min_64_chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800
STORAGE_DIR=storage
TRUST_PROXY=1

# Next.js 16 Frontend Web Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_TELEMETRY_DISABLED=1

# Nginx Reverse Proxy Configuration
NGINX_PORT=80
NGINX_SSL_PORT=443

