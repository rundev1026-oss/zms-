# Copy to apps/api/.env when running the API from this package.
# Nest also loads ../../.env (the repository root) if this file is absent.
# Local defaults only — not real secrets. No personal data.

NODE_ENV=development
API_PORT=3000
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://zms:zms@localhost:5432/zms?schema=public
SEED_USER_PASSWORD=LocalDev-Only-1
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800
STORAGE_DIR=storage
TRUST_PROXY=0
