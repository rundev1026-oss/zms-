model FollowUpPlan {
  id                  String   @id @default(uuid()) @db.Uuid
  legacyId            String?  @unique @map("legacy_id")
  assistanceRecordId  String   @map("assistance_record_id") @db.Uuid
  beneficiaryId       String   @map("beneficiary_id") @db.Uuid
  assistanceType      String   @map("assistance_type")
