model Branch {
  id                String    @id @default(uuid()) @db.Uuid
  legacyId          String?   @unique @map("legacy_id")
  code              String    @unique
  name              String
  nameEn            String?   @map("name_en")
  province          String
  isHeadquarters    Boolean   @default(false) @map("is_headquarters")
  branchType        String?   @default("regional_branch") @map("branch_type")
  parentBranchId    String?   @map("parent_branch_id")
  address           String?
  subdistrict       String?
  district          String?
  postcode          String?
  phone             String?
  email             String?
  managerUserId     String?   @map("manager_user_id")
  managerName       String?   @map("manager_name")
  status            String    @default("active")
  deactivatedReason String?   @map("deactivated_reason")
  createdById       String?   @map("created_by_id")
  createdByName     String?   @map("created_by_name")
  updatedById       String?   @map("updated_by_id")
  updatedByName     String?   @map("updated_by_name")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  departments Department[]

  @@map("branches")
}

model Department {
  id                String    @id @default(uuid()) @db.Uuid
  legacyId          String?   @unique @map("legacy_id")
  code              String    @unique
  name              String
  nameEn            String?   @map("name_en")
  description       String?
  branchId          String?   @map("branch_id") @db.Uuid
  headUserId        String?   @map("head_user_id")
  headName          String?   @map("head_name")
  allowedRoles      String?   @default("[\"officer\"]") @map("allowed_roles")
  status            String    @default("active")
  deactivatedReason String?   @map("deactivated_reason")
  createdById       String?   @map("created_by_id")
  createdByName     String?   @map("created_by_name")
  updatedById       String?   @map("updated_by_id")
  updatedByName     String?   @map("updated_by_name")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@map("departments")
}

