  withdrawal CashFlowWithdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)

  @@index([withdrawalId])
  @@map("finance_handover_records")
}

model FinancialTransaction {
  id               String   @id @default(uuid()) @db.Uuid
  legacyId         String?  @unique @map("legacy_id")
  transactionNo    String   @unique @map("transaction_no")
  date             String
  type             String
  fundId           String   @map("fund_id")
  fundName         String   @map("fund_name")
  category         String
  amount           Decimal  @map("amount") @db.Decimal(18, 2)
  paymentMethod    String   @map("payment_method")
  payerOrPayee     String   @map("payer_or_payee")
  referenceNo      String   @map("reference_no")
  receiptUrl       String?  @map("receipt_url")
  slipUrl          String?  @map("slip_url")
  status           String   @default("completed")
  recordedById     String   @map("recorded_by_id")
  recordedByName   String   @map("recorded_by_name")
  verifiedById     String?  @map("verified_by_id")
  verifiedByName   String?  @map("verified_by_name")
  notes            String?
  reversalRefId    String?  @map("reversal_ref_id")
  reversalReason   String?  @map("reversal_reason")
  reversedAt       String?  @map("reversed_at")
  reversedById     String?  @map("reversed_by_id")
  reversedByName   String?  @map("reversed_by_name")
  bankAccountId    String?  @map("bank_account_id")
  moneyType        String?  @default("zakat") @map("money_type")
  zakatYear        String?  @default("2569") @map("zakat_year")
  asnafCategory    String?  @map("asnaf_category")
  subFundCategory  String?  @map("sub_fund_category")
  beneficiaryId    String?  @map("beneficiary_id")
  applicationId    String?  @map("application_id")
  donorName        String?  @map("donor_name")
  isAnonymous      Boolean  @default(false) @map("is_anonymous")
  usageRestriction String?  @map("usage_restriction")
  workflowId       String?  @map("workflow_id")
  specificFundId   String?  @map("specific_fund_id")
  assistanceTypeId String?  @map("assistance_type_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([transactionNo])
  @@index([date])
  @@index([fundId])
  @@index([type])
  @@map("financial_transactions")
}

