// Domain schema. The partial unique index for active Thai national IDs lives in SQL.
// Partial unique index for active Thai national IDs is appended in the
// initial migration because Prisma 6 cannot declare that predicate in schema.
// Do not drop beneficiaries_thai_national_id_active_key if a later diff lists it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RegistryStatus {
  DRAFT
  PENDING_REVIEW
  NEEDS_CORRECTION
  UNDER_ASSESSMENT
  ELIGIBLE
  INELIGIBLE
  SUSPENDED
  ARCHIVED
}

enum IdentityType {
  THAI_NATIONAL_ID
  OTHER
}

enum AddressType {
  REGISTERED
  CURRENT
}

enum DocumentStatus {
  UPLOADED
  ACCEPTED
  REJECTED
  SUPERSEDED
}

/// Staff decision recorded on an assessment. Not an automatic eligibility result.
enum AsnafDecision {
  PROPOSED
  CONFIRMED
  NOT_CONFIRMED
}

/// Foundation staff. Not a zakat beneficiary.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  legacyId        String?   @unique @map("legacy_id")
  username        String?   @unique
  email           String    @unique
  passwordHash    String    @map("password_hash")
  displayName     String    @map("display_name")
  phone           String?
  position        String?
  branch          String?
  branchId        String?   @map("branch_id")
  departmentId    String?   @map("department_id")
  isActive        Boolean   @default(true) @map("is_active")
  mfaEnabled      Boolean   @default(false) @map("mfa_enabled")
  mfaSecret       String?   @map("mfa_secret")
  mfaRecoveryHash String?   @map("mfa_recovery_hash")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles                 UserRole[]
  permissionOverrides       UserPermissionOverride[]
  dataScope                 UserDataScope?
  permissionAuditLogsActor  PermissionAuditLog[]         @relation("ActorUser")
  permissionAuditLogsTarget PermissionAuditLog[]         @relation("TargetUser")
  refreshTokens             RefreshToken[]
  passwordResetTokens       PasswordResetToken[]
  loginHistories            LoginHistory[]
  beneficiariesCreated      Beneficiary[]                @relation("BeneficiaryCreatedBy")
  beneficiariesUpdated      Beneficiary[]                @relation("BeneficiaryUpdatedBy")
  beneficiariesDeleted      Beneficiary[]                @relation("BeneficiaryDeletedBy")
  addressesCreated          BeneficiaryAddress[]         @relation("AddressCreatedBy")
  addressesUpdated          BeneficiaryAddress[]         @relation("AddressUpdatedBy")
  householdsCreated         Household[]                  @relation("HouseholdCreatedBy")
  householdsUpdated         Household[]                  @relation("HouseholdUpdatedBy")
  householdMembersCreated   HouseholdMember[]            @relation("HouseholdMemberCreatedBy")
  householdMembersUpdated   HouseholdMember[]            @relation("HouseholdMemberUpdatedBy")
  incomeProfilesCreated     IncomeExpenseProfile[]       @relation("IncomeCreatedBy")
  incomeProfilesUpdated     IncomeExpenseProfile[]       @relation("IncomeUpdatedBy")
  assessmentsRecorded       BeneficiaryAsnafAssessment[] @relation("AssessmentRecordedBy")
  assessmentsReviewed       BeneficiaryAsnafAssessment[] @relation("AssessmentReviewedBy")
  documentsUploaded         BeneficiaryDocument[]        @relation("DocumentUploadedBy")
  documentsReviewed         BeneficiaryDocument[]        @relation("DocumentReviewedBy")
  statusChanges             RegistryStatusHistory[]      @relation("StatusActedBy")
  consentsRecorded          ConsentRecord[]              @relation("ConsentRecordedBy")
  auditLogs                 AuditLog[]                   @relation("AuditActor")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isCustom    Boolean  @default(false) @map("is_custom")
  isSystem    Boolean  @default(false) @map("is_system")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles                 UserRole[]
  rolePermissions           RolePermission[]
  permissionAuditLogsTarget PermissionAuditLog[] @relation("TargetRole")

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserPermissionOverride {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  permissionCode String   @map("permission_code")
  effect         String // "ALLOW" | "DENY"
  reason         String?
  grantedBy      String?  @map("granted_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionCode])
  @@index([userId])
  @@map("user_permission_overrides")
}

model UserDataScope {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  scope         String   @default("BRANCH") // "OWN" | "DEPARTMENT" | "BRANCH" | "ORGANIZATION"
  branchId      String?  @map("branch_id")
  departmentId  String?  @map("department_id")
  approvalLimit Decimal? @map("approval_limit") @db.Decimal(18, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_data_scopes")
}

model PermissionAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  targetRoleId String?  @map("target_role_id") @db.Uuid
  action       String // "ROLE_CREATE" | "ROLE_UPDATE" | "ROLE_ASSIGN_PERM" | "USER_OVERRIDE_PERM" | "USER_SCOPE_UPDATE" | "USER_ROLE_CHANGE" | "USER_STATUS_CHANGE"
  details      Json?
  reason       String?
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor      User  @relation("ActorUser", fields: [actorId], references: [id], onDelete: Restrict)
  targetUser User? @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetRole Role? @relation("TargetRole", fields: [targetRoleId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetUserId])
  @@index([targetRoleId])
  @@map("permission_audit_logs")
}

/// Stores a hash of the refresh token. Never store the raw token.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Registry status lives only on this model.
model Beneficiary {
  id                       String         @id @default(uuid()) @db.Uuid
  legacyId                 String?        @unique @map("legacy_id")
  registryNumber           String         @unique @map("registry_number")
  status                   RegistryStatus @default(DRAFT)
  title                    String?
  firstName                String         @map("first_name")
  lastName                 String         @map("last_name")
  identityType             IdentityType   @map("identity_type")
  identityNumber           String?        @map("identity_number")
  identityNumberNormalized String?        @map("identity_number_normalized")
  dateOfBirth              DateTime?      @map("date_of_birth") @db.Date
  phone                    String?
  occupation               String?
  maritalStatus            String?        @map("marital_status")
  registrationNote         String?        @map("registration_note")
  deletedAt                DateTime?      @map("deleted_at") @db.Timestamptz(6)
  deletedById              String?        @map("deleted_by_id") @db.Uuid
  deletionReason           String?        @map("deletion_reason")
  deletionReference        String?        @map("deletion_reference")
  deletionStatus           Boolean        @default(false) @map("deletion_status")
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById              String?        @map("created_by_id") @db.Uuid
  updatedById              String?        @map("updated_by_id") @db.Uuid

  createdBy             User?                            @relation("BeneficiaryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy             User?                            @relation("BeneficiaryUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedBy             User?                            @relation("BeneficiaryDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  addresses             BeneficiaryAddress[]
  household             Household?
  incomeProfile         IncomeExpenseProfile?
  assessments           BeneficiaryAsnafAssessment[]
  documents             BeneficiaryDocument[]
  statusHistory         RegistryStatusHistory[]
  consents              ConsentRecord[]
  applications          AssistanceApplication[]
  followUpPlans         FollowUpPlan[]
  followUpRecords       FollowUpRecord[]
  disbursementItems     CashFlowDisbursementItem[]
  editHistories         BeneficiaryEditHistory[]
  registrationHistories BeneficiaryRegistrationHistory[]

  @@index([status])
  @@index([deletedAt])
  @@index([deletionStatus])
  @@index([status, deletedAt])
  @@index([lastName, firstName])
  @@index([phone])
  @@index([identityNumberNormalized])
  @@map("beneficiaries")
}

/// Registered-home and current addresses. One row per address type.
model BeneficiaryAddress {
  id            String      @id @default(uuid()) @db.Uuid
  beneficiaryId String      @map("beneficiary_id") @db.Uuid
  addressType   AddressType @map("address_type")
  addressLine   String?     @map("address_line")
  community     String?
  subdistrict   String?
  district      String?
  province      String?
  postalCode    String?     @map("postal_code")
  latitude      Decimal?    @db.Decimal(10, 7)
  longitude     Decimal?    @db.Decimal(10, 7)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById   String?     @map("created_by_id") @db.Uuid
  updatedById   String?     @map("updated_by_id") @db.Uuid

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  createdBy   User?       @relation("AddressCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?       @relation("AddressUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([beneficiaryId, addressType])
  @@index([province])
  @@index([community])
  @@map("beneficiary_addresses")
}

model Household {
  id                         String   @id @default(uuid()) @db.Uuid
  legacyId                   String?  @map("legacy_id")
  householdNo                String?  @map("household_no")
  beneficiaryId              String   @unique @map("beneficiary_id") @db.Uuid
  memberCount                Int?     @map("member_count")
  householdIncome            Decimal? @map("household_income") @db.Decimal(18, 2)
  householdExpense           Decimal? @map("household_expense") @db.Decimal(18, 2)
  debtAmount                 Decimal? @map("debt_amount") @db.Decimal(18, 2)
  debtPurpose                String?  @map("debt_purpose")
  dependentCount             Int?     @map("dependent_count")
  additionalNotes            String?  @map("additional_notes")
  address                    String?
  province                   String?
  district                   String?
  subdistrict                String?
  community                  String?
  housingCondition           String?  @map("housing_condition")
  housingNotes               String?  @map("housing_notes")
  housingType                String?  @map("housing_type")
  landTitleType              String?  @map("land_title_type")
  landTitleNotes             String?  @map("land_title_notes")
  livingScore                Int?     @default(0) @map("living_score")
  incomeBreakdown            String?  @map("income_breakdown")
  expenseBreakdown           String?  @map("expense_breakdown")
  pastAssistance             String?  @map("past_assistance")
  familySituationSummary     String?  @map("family_situation_summary")
  urgentNeeds                String?  @map("urgent_needs")
  dependentBurdens           String?  @map("dependent_burdens")
  coordinatorInfo            String?  @map("coordinator_info")
  certifierInfo              String?  @map("certifier_info")
  latitude                   Decimal? @db.Decimal(10, 7)
  longitude                  Decimal? @db.Decimal(10, 7)
  residenceAddress           String?  @map("residence_address")
  placeName                  String?  @map("place_name")
  locationUpdatedAt          String?  @map("location_updated_at")
  locationUpdatedBy          String?  @map("location_updated_by")
  locationVerificationStatus String?  @default("not_specified") @map("location_verification_status")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById                String?  @map("created_by_id") @db.Uuid
  updatedById                String?  @map("updated_by_id") @db.Uuid

  beneficiary Beneficiary       @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  members     HouseholdMember[]
  createdBy   User?             @relation("HouseholdCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?             @relation("HouseholdUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([householdNo])
  @@map("households")
}

model HouseholdMember {
  id              String    @id @default(uuid()) @db.Uuid
  legacyId        String?   @map("legacy_id")
  householdId     String    @map("household_id") @db.Uuid
  fullName        String    @map("full_name")
  relationship    String
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  ageYears        Int?      @map("age_years")
  occupation      String?
  isDependent     Boolean   @default(false) @map("is_dependent")
  monthlyIncome   Decimal?  @default(0) @map("monthly_income") @db.Decimal(18, 2)
  healthStatus    String?   @default("healthy") @map("health_status")
  healthNotes     String?   @map("health_notes")
  educationStatus String?   @map("education_status")
  notes           String?
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById     String?   @map("created_by_id") @db.Uuid
  updatedById     String?   @map("updated_by_id") @db.Uuid

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("HouseholdMemberCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?     @relation("HouseholdMemberUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([householdId])
  @@map("household_members")
}

/// Personal necessity profile. Kept apart from the household snapshot.
model IncomeExpenseProfile {
  id                     String   @id @default(uuid()) @db.Uuid
  beneficiaryId          String   @unique @map("beneficiary_id") @db.Uuid
  personalIncome         Decimal? @map("personal_income") @db.Decimal(18, 2)
  regularExpense         Decimal? @map("regular_expense") @db.Decimal(18, 2)
  debtBurden             Decimal? @map("debt_burden") @db.Decimal(18, 2)
  housingCondition       String?  @map("housing_condition")
  livingConstraints      String?  @map("living_constraints")
  assistanceNeeds        String?  @map("assistance_needs")
  otherAgencyAssistance  String?  @map("other_agency_assistance")
  priorAssistanceHistory String?  @map("prior_assistance_history")
  officerNote            String?  @map("officer_note")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById            String?  @map("created_by_id") @db.Uuid
  updatedById            String?  @map("updated_by_id") @db.Uuid

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  createdBy   User?       @relation("IncomeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?       @relation("IncomeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("income_expense_profiles")
}

model AsnafCategory {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  nameTh    String   @map("name_th")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assessments BeneficiaryAsnafAssessment[]

  @@index([isActive, sortOrder])
  @@map("asnaf_categories")
}

/// Append-only assessment history. The latest CONFIRMED row is the category to display.
model BeneficiaryAsnafAssessment {
  id             String        @id @default(uuid()) @db.Uuid
  beneficiaryId  String        @map("beneficiary_id") @db.Uuid
  categoryId     String        @map("category_id") @db.Uuid
  rationale      String
  supportingInfo String?       @map("supporting_info")
  recordedById   String?       @map("recorded_by_id") @db.Uuid
  assessedAt     DateTime      @map("assessed_at") @db.Timestamptz(6)
  reviewedById   String?       @map("reviewed_by_id") @db.Uuid
  decision       AsnafDecision @default(PROPOSED)
  reviewerNote   String?       @map("reviewer_note")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  beneficiary Beneficiary   @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  category    AsnafCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recordedBy  User?         @relation("AssessmentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  reviewedBy  User?         @relation("AssessmentReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([beneficiaryId, decision])
  @@index([beneficiaryId, assessedAt])
  @@index([categoryId])
  @@map("beneficiary_asnaf_assessments")
}

/// Private file metadata. There is no public URL column.
model BeneficiaryDocument {
  id               String         @id @default(uuid()) @db.Uuid
  beneficiaryId    String         @map("beneficiary_id") @db.Uuid
  documentType     String         @map("document_type")
  originalFileName String         @map("original_file_name")
  storageKey       String         @unique @map("storage_key")
  sizeBytes        Int            @map("size_bytes")
  mimeType         String         @map("mime_type")
  status           DocumentStatus @default(UPLOADED)
  uploadedById     String?        @map("uploaded_by_id") @db.Uuid
  reviewedById     String?        @map("reviewed_by_id") @db.Uuid
  reviewedAt       DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  reviewNote       String?        @map("review_note")
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  uploadedBy  User?       @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewedBy  User?       @relation("DocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([beneficiaryId, deletedAt])
  @@index([status])
  @@map("beneficiary_documents")
}

/// Append-only registry status changes. Not used for assistance-request status.
model RegistryStatusHistory {
  id            String          @id @default(uuid()) @db.Uuid
  beneficiaryId String          @map("beneficiary_id") @db.Uuid
  fromStatus    RegistryStatus? @map("from_status")
  toStatus      RegistryStatus  @map("to_status")
  reason        String?
  actedById     String?         @map("acted_by_id") @db.Uuid
  actedAt       DateTime        @default(now()) @map("acted_at") @db.Timestamptz(6)

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  actedBy     User?       @relation("StatusActedBy", fields: [actedById], references: [id], onDelete: Restrict)

  @@index([beneficiaryId, actedAt])
  @@map("registry_status_histories")
}

/// Append-only consent. A new confirmation inserts a new row.
model ConsentRecord {
  id                   String   @id @default(uuid()) @db.Uuid
  beneficiaryId        String   @map("beneficiary_id") @db.Uuid
  consentTextVersion   String   @map("consent_text_version")
  privacyNoticeVersion String   @map("privacy_notice_version")
  accepted             Boolean
  channel              String?
  recordedAt           DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  recordedById         String?  @map("recorded_by_id") @db.Uuid

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  recordedBy  User?       @relation("ConsentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([beneficiaryId, recordedAt])
  @@map("consent_records")
}

/// metadata must not contain passwords, tokens, full identity numbers, or file bytes.
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  legacyId     String?  @unique @map("legacy_id")
  actorId      String?  @map("actor_id") @db.Uuid
  userName     String?  @map("user_name")
  userRole     String?  @map("user_role")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  description  String?
  ipAddress    String?  @default("127.0.0.1") @map("ip_address")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Allocates ZMS-YYYY-###### without accepting a number from the client.
model RegistryCounter {
  year      Int @id
  lastValue Int @default(0) @map("last_value")

  @@map("registry_counters")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model LoginHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  email     String
  ipAddress String   @map("ip_address")
  userAgent String?  @map("user_agent")
  status    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([createdAt])
  @@map("login_histories")
}

