  branchName               String?  @default("สำนักงานใหญ่ กรุงเทพมหานคร") @map("branch_name")
  hardshipReasons          String?  @map("hardship_reasons")
  assistanceType           String?  @default("cash") @map("assistance_type")
  assistanceTypeDetails    String?  @map("assistance_type_details")
  necessityDetails         String?  @map("necessity_details")
  evaluatorChecklist       String?  @map("evaluator_checklist")
  rejectionReason          String?  @map("rejection_reason")
  memberId                 String?  @map("member_id")
  registrationNo           String?  @map("registration_no")
  assistanceTypeId         String?  @map("assistance_type_id")
  assistanceGroup          String?  @default("core") @map("assistance_group")
  assistanceResultStatus   String?  @default("not_started") @map("assistance_result_status")
  assistanceOutcome        String?  @map("assistance_outcome")
  actualAssistanceValue    Decimal? @default(0) @map("actual_assistance_value") @db.Decimal(18, 2)
  executionConfirmedAt     String?  @map("execution_confirmed_at")
  executionConfirmedById   String?  @map("execution_confirmed_by_id")
  executionConfirmedByName String?  @map("execution_confirmed_by_name")
  installmentCount         Int      @default(1) @map("installment_count")
  currentInstallment       Int      @default(1) @map("current_installment")
  refundedAmount           Decimal? @default(0) @map("refunded_amount") @db.Decimal(18, 2)
  isRefunded               Boolean  @default(false) @map("is_refunded")
  primaryGroupCode         String?  @map("primary_group_code")
  specificFundId           String?  @map("specific_fund_id")
  specificFundCode         String?  @map("specific_fund_code")
  specificFundName         String?  @map("specific_fund_name")
  approvedFundId           String?  @map("approved_fund_id")
  approvedSpecificFundId   String?  @map("approved_specific_fund_id")
