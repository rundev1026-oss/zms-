  history           ApplicationHistory[]
  legacyAssessment  BeneficiaryAssessmentLegacy?
  executionRecords  AssistanceExecutionRecord[]
  refundRecords     AssistanceRefundRecord[]
  discrepancies     AssistanceFinanceDiscrepancy[]
