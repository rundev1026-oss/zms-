{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "setupFiles": ["<rootDir>/setup-env.ts"],
  "moduleNameMapper": {
    "^@zms/shared$": "<rootDir>/../../../packages/shared/src/index.ts"
  }
}
